 static ssize_t ksu_rc_pos = 0;
 const size_t ksu_rc_len = sizeof(KERNEL_SU_RC) - 1;
 
+/*
+ * Android 17's init sizes its buffer from fstat() and reads init.rc with a
+ * single read_iter(), so there is neither an EOF read nor spare room in the
+ * destination buffer to append into. Instead of appending, replace the whole
+ * file content with a same-length variant generated from this ROM's init.rc
+ * (comment lines swapped for the ksud exec lines). See ksu_rc_blob.h.
+ */
+static bool ksu_rc_blob_active;
+
+#include "ksu_rc_blob.h"
+
+static ssize_t ksu_rc_blob_read_iter(struct kiocb *iocb, struct iov_iter *to)
+{
+	size_t left, n;
+
+	if (iocb->ki_pos < 0 || (size_t)iocb->ki_pos >= ksu_rc_blob_len)
+		return 0;
+
+	left = ksu_rc_blob_len - (size_t)iocb->ki_pos;
+	n = min_t(size_t, iov_iter_count(to), left);
+	if (copy_to_iter(ksu_rc_blob + iocb->ki_pos, n, to) != n)
+		return -EFAULT;
+
+	iocb->ki_pos += n;
+	return n;
+}
+
+static ssize_t ksu_rc_blob_read(char __user *buf, size_t count, loff_t *pos)
+{
+	size_t left, n;
+
+	if (!pos || *pos < 0 || (size_t)*pos >= ksu_rc_blob_len)
+		return 0;
+
+	left = ksu_rc_blob_len - (size_t)*pos;
+	n = min(count, left);
+	if (copy_to_user(buf, ksu_rc_blob + *pos, n))
+		return -EFAULT;
+
+	*pos += n;
+	return n;
+}
