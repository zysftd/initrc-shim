diff --git a/kernel/hook/patch_memory.c b/kernel/hook/patch_memory.c
--- a/kernel/hook/patch_memory.c
+++ b/kernel/hook/patch_memory.c
@@ -8,12 +8,10 @@
 #include "patch_memory.h"
 #include <linux/version.h>
 
-// copy_to_kernel_nofault() was introduced in 5.8; before that it was
-// named probe_kernel_write()
-#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
-#define copy_to_kernel_nofault(dst, src, size)                                 \
-	probe_kernel_write((dst), (src), (size))
-#endif
+// copy_to_kernel_nofault() was introduced upstream in 5.8, but this 4.19
+// tree already backports it (mm/maccess.c + linux/uaccess.h), so no compat
+// alias is needed here. Defining the macro would also rewrite the prototype
+// in linux/uaccess.h and break compilation.
 
 #if defined(__aarch64__)
 
