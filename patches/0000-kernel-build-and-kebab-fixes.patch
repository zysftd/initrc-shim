diff --git a/scripts/engine_compat.c b/scripts/engine_compat.c
new file mode 100644
index 000000000..3518e74bf
--- /dev/null
+++ b/scripts/engine_compat.c
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal ENGINE stubs for building extract-cert against OpenSSL 3.x
+ * installations that are built without the (deprecated) ENGINE API.
+ *
+ * We never use PKCS#11 keys for this build (CONFIG_SYSTEM_TRUSTED_KEYS
+ * is empty), so returning failure from the "load" helpers is safe and
+ * keeps the linker happy.  Do not use this for real PKCS#11 key loading.
+ */
+#include <openssl/engine.h>
+
+void ENGINE_load_builtin_engines(void)
+{
+}
+
+ENGINE *ENGINE_by_id(const char *id)
+{
+	(void)id;
+	return NULL;
+}
+
+int ENGINE_init(ENGINE *e)
+{
+	(void)e;
+	return 0;
+}
+
+int ENGINE_ctrl_cmd_string(ENGINE *e, const char *cmd, const char *arg,
+			   int optional)
+{
+	(void)e;
+	(void)cmd;
+	(void)arg;
+	(void)optional;
+	return 0;
+}
+
+int ENGINE_ctrl_cmd(ENGINE *e, const char *cmd, long i, void *p,
+		    void (*f)(void), int cmd_optional)
+{
+	(void)e;
+	(void)cmd;
+	(void)i;
+	(void)p;
+	(void)f;
+	(void)cmd_optional;
+	return 0;
+}
